<!DOCTYPE html>
<html lang="en">

<head>
<title>Match Details</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="Rooks">
<meta name="description" content="Match Details">

<link rel="icon" href="/assets/icons/rooksIconGG.png">
<link rel="stylesheet" href="/styles.css">
<script src="/plugins/jquery-3.4.1.min.js"></script>

<style>

main {
    width: 70vw;
    min-height: 100vh;
    background-color: inherit;
}

ul {
    gap: 1em;
}

li > ul > li:not(:first-of-type) { margin-left: 2em; }
li > ul > li:last-child { margin-bottom: 1em; }



table#stats {
    height: 800px;
    overflow: scroll;
}
table#stats thead th {
    height: 110px;
    position: sticky;
    top: 56px;
}

table#stats thead th:first-of-type {
    background-color: transparent;
}

tbody td {
    height: 38px;
    padding: 8px;
}

table img {
    width: 100%;
    margin: 0 auto;
    /*border-radius: 4px;*/
}

tr.section > th {
    color: #e8e8e8;
    /*height: 38px;*/
    vertical-align: bottom;
    border-top: 1px solid var(--purple100);
    text-align: left;
    font-size: 14px;
    padding: 12px;
}

table#stats tr > td:first-of-type {
    border-right: 1px solid var(--purple100);
    text-align: left;
    padding: 8px 8px 8px 32px;
}

thead th.team100 { background-color: var(--img-bg-blue); }
thead th.team200 { background-color: var(--img-bg-red); }

th.dd-cent {
    background-position: top 0% right 50%;
    background-size: 100% auto;
    background-blend-mode: luminosity;
    filter: brightness(100%) grayscale(25%) contrast(100%);
}

th.dd-cent ul {
    width: 110px;
    height: 100%;
    color: var(--text100);
    padding: 4px;
    gap: 0px;
    font-size: 10px;
    font-stretch: 75%;
    font-variation-settings:
        "GRAD" 75,
        "XTRA" 440,
        "XOPQ" 92;
    text-shadow:
        -1.5px -1.5px 0.1em rgba(0,0,0,0.75),
        1.5px -1.5px 0.1em rgba(0,0,0,0.75),
        -1.5px 1.5px 0.1em rgba(0,0,0,0.75),
        1.5px 1.5px 0.1em rgba(0,0,0,0.75);
}

th.dd-cent li {
    width: 100%;
    overflow: hidden;
    padding: 4px;
}

th.dd-cent li.medium { font-weight: 550; margin-bottom: auto; }
th.dd-cent li.medium span { color: var(--text400); font-weight: var(--font-regular); }

th.dd-cent li.medium a:hover {
    color: var(--text500);
}
th.dd-cent li.medium a:hover span { color: var(--text500); }


span.role-icon {
    display: inline-block;
    height: 1em;
    aspect-ratio: 1 / 1;
    vertical-align: top;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100%;
    background-color: rgba(0,0,0,0.5);
    border-radius: 2px;
    transform: scale(1.5);
    margin-left: 4px;
}


table#stats tr:hover > td {
    color: white;
    font-variation-settings:
        "GRAD" 100;
}


/* Client Design Style */
table#stats tbody tr:not(.section):hover { outline: 2px solid #614a25; border-radius: 2px; }

table#stats tbody tr:hover > td {
    background-color: var(--purple400);
    border-top: 1px solid var(--purple300);
}

span.icon {
    position: absolute;
    display: inline-block;
    height: 1em;
    width: 1em;
    background-repeat: no-repeat;
    background-position: top 0% left 0%;
    background-size: cover;
    vertical-align: top;
    /*margin-right: 0.4em;*/
    transform: scale(1.6) translate(-14px, 0);
}





table#runes td {
    height: 96px;
    padding: 8px 4px;
}

table#runes tr.team100 td:first-of-type { background-color: var(--img-bg-blue); }
table#runes tr.team200 td:first-of-type { background-color: var(--img-bg-red); }
table#runes tr.team100 td { background-color: var(--blue100); }
table#runes tr.team200 td { background-color: var(--red100); }

table#runes td.dd-cent {
    background-position: bottom 85% right 50%;
    background-size: auto 180%;
    background-blend-mode: luminosity;
    filter: brightness(100%) grayscale(25%) contrast(100%);
    /*-webkit-mask-image: linear-gradient( 90deg,
        rgba(0,0,0,1) 0%,
        rgba(0,0,0,1) 75%,
        rgba(0,0,0,0) 100%
    );*/
}

table#runes ul {
    font-size: 10px;
    gap: 0.75em;
    width: 100%;
    /*font-stretch: 75%;*/
    /*font-variation-settings: var(--condensed);*/
}

table#runes li.strong {
    font-size: 10px;
    color: #c8c8c8;
}

table#runes td.style img {
    border: 2px ridge;
    border-radius: 50%;
    filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));
}

table#runes td.style.Precision > img    { border-color: #bba87b; }
table#runes td.style.Domination > img   { border-color: #d84545; }
table#runes td.style.Sorcery > img      { border-color: #858ff8; }
table#runes td.style.Resolve > img      { border-color: #a2d289; }
table#runes td.style.Inspiration > img  { border-color: #48afbb; }

table#runes td.stat-perk img {
    border: 1px solid rgb(187, 152, 52);
    border-radius: 50%;
    background-color: #282828;
}

</style>

</head>

<!-- ★ ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── ★ -->

<body>

<%- include("partials/navigation-bar") %>


<main>

<ul>
    <li><span class="dull">matchId</span> – <%= general.metadata.matchId %></li>
    <li><span class="dull">gameVersion</span> – <%= general.info.gameVersion %></li>
    <li><span class="dull">gameId</span> – <%= general.info.gameId %></li>
    <br>
    <li><span class="dull">gameCreation</span> – <%= (new Date(general.info.gameCreation)).toLocaleTimeString("en-US", {timeZone: "America/New_York",hour: "numeric",minute: "numeric"}) %></li>
    <li><span class="dull">gameStartTimestamp</span> – <%= (new Date(general.info.gameStartTimestamp)).toLocaleTimeString("en-US",{timeZone: "America/New_York",hour: "numeric",minute: "numeric"}) %></li>
    <li><span class="dull">gameEndTimestamp</span> – <%= (new Date(general.info.gameEndTimestamp)).toLocaleTimeString("en-US", {timeZone: "America/New_York",hour: "numeric",minute: "numeric"}) %></li>
    <li><span class="dull">gameDateTimestamp</span> – <%= general.gameDateTimestamp %></li>
    <li><span class="dull">gameDuration</span> – <%= general.info.gameDuration %></li>
</ul>

<br><br>


<table id="stats" class="default">

    <colgroup>
        <col width="128px">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
        <col width="auto">
    </colgroup>


    <!-- Champion/Players -->
    <thead>
        <tr>
            <th></th>
            <% participants.forEach(function(player, index, array) { %>
            <!-- <th><img class="team<%= player.teamId  %>" src="<%= player.champion.img.centered %>"></th> -->

            <th class="dd-cent team<%= player.teamId %>" style="background-image: url('<%= player.champion.img.tiles %>')">
                <ul class="left">
                    <li class="medium left"><a target="_blank" href="<%= 'https://www.op.gg/' %>"><%= player.riotIdGameName %><span>#<%= player.riotIdTagline %></span></a></li>
                    <li class="right">
                        <%= player.championName %>
                        <span class="role-icon" style="background-image: url('assets/icons/svgs/role/role-<%= player.position %>-w.svg');"></span>
                    </li>
                </ul>
            </th>
            <% }) %>
        </tr>
    </thead>



    <!-- Data Variables ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── -->
    <tbody>
    <% matchVars.forEach(function(section, ind, arr) { %>

        <!-- Section Header ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── -->
        <tr class="section"><th colspan="100%"><%= section.header %></th></tr>

        <!-- Individual Data Variables ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── -->
        <% section.variables.forEach(function(variable) {%>
        <tr>
            <td>
                <% if (variable.icon != null) { %><span class="icon" style="background-image: url('<%= variable.icon %>');"></span><% } %>
                <%= variable.key %>
            </td>

            <% participants.forEach(function(player, index, array) { %>
            <td class="team<%= player.teamId %>">
                <% if (player[variable.data] !== undefined) { %><%= player[variable.data] %><% } else { %>-<% } %>
            </td>
            <% }) %>
        </tr>
        <% }) %>

    <% }) %>
    </tbody>




</table>








</main>


<!-- Rune Table ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── -->
<table id="runes" class="default">

    <colgroup>
        <col width="192px">
        <col width="52px">
        <col width="160px">
        <% for (let i = 0; i < 5; i++) { %>
        <col width="38px">
        <col width="160px">
        <% } %>
        <% for (let i = 0; i < 3; i++) { %>
        <col width="28px">
        <% } %>
    </colgroup>

    <tbody>
        <% participants.forEach(function(player, index, array) { %>
        <tr class="team<%= player.teamId %>">
            <td class="dd-cent" style="background-image: url('<%= player.champion.img.centeredsmall %>')"></td>
            <% player.perks.styles.forEach(function(style, index) { %>
            <td class="<% if (index == 0) { %>keystone<% } else { %>style<% } %> <%= style.path %>"><img src="<%= style.img %>"></td>
            <td><ul class="left">
                <li class="strong"><%= style.name %></li>
                <% style.endOfGameStatDescs.forEach(function(desc) { %>
                <li><%= desc %></li>
                <% }) %>
            </ul></td>
            <% }) %>
            <td class="stat-perk"><img src="<%= player.perks.statPerks.offense.img %>"></td>
            <td class="stat-perk"><img src="<%= player.perks.statPerks.flex.img %>"></td>
            <td class="stat-perk"><img src="<%= player.perks.statPerks.defense.img %>"></td>
        </tr>
        <% }) %>
    </tbody>

</table>


</body>

</html>
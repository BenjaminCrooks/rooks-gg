<!DOCTYPE html>
<html lang="en">

<head>
<title>Data Table - Drafting Counters</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="Rooks">
<meta name="description" content="Win rate table">

<link rel="icon" href="/assets/icons/rooksIconGG.png">
<link rel="stylesheet" href="/styles.css">
<script src="/plugins/jquery-3.4.1.min.js"></script>

<style>

main {
	width: auto;
	align-items: center;
	gap: 64px;
	padding: 0px 8px 8px 8px;
}

table {
	table-layout: auto;
/*		width: 100%;*/
}

th {
	height: 48px;
}

td {
	height: 64px;
	padding: 8px 16px;
}

table ul {
	gap: 8px;
}

.winrate-bar {
	width: 100%;
	font-size: 11px;
}

td.champion-name, td.winrate-perc {
	padding-left: 4px;
	text-align: left;
	font-weight: var(--font-bold);
}

tr > td:first-of-type { font-weight: var(--font-medium); } /* rank; col 1 */
td.icon { padding: 8px; }
td.icon.role { padding: 18px; }
td.icon > img { width: 100%; }

span.icon {
	display: inline-block;
	height: 1em;
	width: 1em;
	background-repeat: no-repeat;
	background-position: top 0% left 0%;
	background-size: cover;
	vertical-align: top;
}

span.icon.cs { background-image: url("/assets/icons/svgs/minion-grey.svg"); }
span.icon.gold { background-image: url("/assets/icons/svgs/gold-grey.svg"); }

td.champion.icon > img {
	border-radius: 4px;
}

header a {
	padding: 8px 16px;
}

header a:hover {
	color: white;
	font-variation-settings:
    	"GRAD" 150;
}

</style>

</head>

<body>

<%- include("partials/navigation-bar") %>


<header>
	<a href="/draft/84/counters">Akali</a>
	<a href="/draft/166/counters">Akshan</a>
	<a href="/draft/245/counters">Ekko</a>
	<a href="/draft/4/counters">Twisted Fate</a>
	<a href="/draft/105/counters">Fizz</a>
	<a href="/draft/3/counters">Galio</a>
	<a href="/draft/910/counters">Hwei</a>
	<a href="/draft/38/counters">Kassadin</a>
	<a href="/draft/55/counters">Katarina</a>
	<a href="/draft/7/counters">LeBlanc</a>
	<a href="/draft/61/counters">Orianna</a>
	<a href="/draft/246/counters">Qiyana</a>
	<a href="/draft/13/counters">Ryze</a>
	<a href="/draft/517/counters">Sylas</a>
	<a href="/draft/134/counters">Syndra</a>
	<a href="/draft/91/counters">Talon</a>
	<a href="/draft/112/counters">Viktor</a>
	<a href="/draft/8/counters">Vladimir</a>
	<a href="/draft/101/counters">Xerath</a>
	<a href="/draft/157/counters">Yasuo</a>
	<a href="/draft/777/counters">Yone</a>
	<a href="/draft/238/counters">Zed</a>
	<a href="/draft/142/counters">Zoe</a>
</header>

<main>

	
	<table class="bevel">
	<!-- <table> -->

        <colgroup>
            <col width="64px"> <!-- rank -->
        	<col width="64px"> <!-- champion icon -->
            <col width="96px"> <!-- champion name -->
            <col width="128px"> <!-- kda -->
            <col width="256px"> <!-- win rate bar -->
            <col width="64px"> <!-- win rate % -->
            <col width="80px"> <!-- matches played -->
            <col width="80px"> <!-- pick rate -->
        </colgroup>

        <thead>
        	<tr class="title">
        		<th colspan="100%"><h3>Win Rates</h3></th>
        	</tr>
        	<tr>
        		<th>Rank</th>
        		<th colspan="2">Champion</th>
        		<th>KDA</th>
        		<th colspan="2">Win Rate</th>
        		<th>Matches</th>
        		<th>Pick Rate</th>
        	</tr>
        </thead>

        <tbody>

        <% rows.forEach(function(row, index) { %>
            <tr>

            	<td><%= index + 1 %></td>

            	<td class="champion icon"><img src="<%= row.champion.img.squarecrop %>"></td>

                <td class="champion-name"><%= row.champion.name %></td>

            	<td><ul class="center">
            		<li class="strong<% if (row.kda >= 6) { %> legendary<% } else if (row.kda >= 4.5) { %> epic<% } else if (row.kda >= 3) { %> rare<% } else if (row.kda <= 2) { %> boosted<% } %>"><%= row.kda %><span class="dull">:1</span></li>
            		<li><%= row.kills %> / <%= row.deaths %> / <%= row.assists %></li>
            	</ul></td>

                <td><div class="winrate-bar">
			        <% if (row.wins !== 0) { %>
			        <div style="width:<%= row.winrate %>%;"><%= row.wins %>W</div>
			        <% }; if (row.losses !== 0) { %>
			        <span><%= row.losses %>L</span>
			        <% } %>
				</div></td>

                <td class="winrate-perc<% if (row.winrate >= 70) { %> legendary<% } else if (row.winrate >= 60) { %> epic<% } else if (row.winrate >= 55) { %> rare<% } else if (row.winrate <= 40) { %> boosted<% } %>"><%= row.winrate %><span class="dull">%</span></td>

            	<td><%= row.matches %> Played</td>

            	<td class="strong"><%= row.pickrate %><span class="dull">%</span></td>

            </tr>
        <% }) %>

        </tbody>

    </table>


</main>

</body>

</html>